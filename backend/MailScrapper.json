      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n\n  const raw = item.json.content.parts[0].text;\n\n  const cleaned = raw\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  const ai = JSON.parse(cleaned);\n\n  return {\n    json: {\n      message_id: item.json.id,\n      thread_id: item.json.threadId,\n      sender: item.json.from,\n      subject: item.json.subject,\n      body: item.json.textPlain || item.json.snippet,\n\n      category: ai.category,\n      priority: ai.priority,\n      sentiment: ai.sentiment,\n      confidence: ai.confidence,\n      suggested_reply: ai.suggested_reply,\n\n      status: \"Open\",\n      created_at: new Date().toISOString()\n    }\n  };\n});\n"
